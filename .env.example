# Django
DJANGO_SECRET_KEY=change-me
DEBUG=False
DJANGO_LOGLEVEL=info
# Add the domain or the IP the application is served on
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Celery broker
REDIS_URL=redis://redis:6379/0

# MQTT broker the sensors publish on
MQTT_BROKER_URL=mqtt://mqtt:1883
# How often the listener reads the sensor table again, in seconds
MQTT_SYNC_SECONDS=30
# How often the measures received are written on the plants, in seconds
PLANT_SYNC_SECONDS=30
# How often the plugs are told the state they should be in, in seconds
ACTIONNER_SYNC_SECONDS=60
# How often the application takes its own decisions, in seconds
DECISION_SECONDS=60
# How often the plugs are checked against the measures of their plant, in seconds
COHERENCE_SECONDS=300

# Database
DATABASE_ENGINE=postgresql
DATABASE_NAME=bonjour_plant
DATABASE_USERNAME=bonjour_plant
DATABASE_PASSWORD=change-me-too
DATABASE_HOST=db
DATABASE_PORT=5432
